# ---------------------------------------------
# Environment config for SauceDemo automation
# ---------------------------------------------

# UI
BASE_URL=https://www.saucedemo.com/

# Login credentials (SauceDemo standard user)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Other available SauceDemo users (swap in for negative tests)
LOCKED_USER=locked_out_user
PROBLEM_USER=problem_user
GLITCH_USER=performance_glitch_user

# API 
# SauceDemo has no public REST API of its own. This is left here so the
# api/ folder has a real place to point to if/when you wire up a backend
# (e.g. a mock API, or your own service under test).
API_BASE_URL=https://www.saucedemo.com
API_KEY=https://automationexercise.com/api

# Checkout / user details used in the "fill user details" step
CHECKOUT_FIRST_NAME=John
CHECKOUT_LAST_NAME=Doe
CHECKOUT_POSTAL_CODE=600001
